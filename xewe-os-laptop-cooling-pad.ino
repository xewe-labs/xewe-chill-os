// xewe-os-laptop-cooling-pad/xewe-os-laptop-cooling-pad.ino
//
// XeWe laptop cooling pad on XeWe OS: XeWeCore's Os, the selected repo modules (wifi, web-interface;
// generated Modules.h), then the pad's own modules in src/ (licensed separately, see README.md).
// - Project name, version, timestamp: generated by `xewe build` (xewe.lock [project]); see Config.h.
// - Pad wiring defaults: Config.h (PAD_*), applied on each pad module's first boot.
// - Modules: never edit src/modules/ by hand; ./setup.sh generates it and Modules.h declares them.

#include <XeWeCore.h>

#include "Config.h"

// The Os comes first: modules register themselves with it from their constructors.
XeWeOs os({
    .project_name    = PROJECT_NAME,
    .version         = BUILD_VERSION,
    .build_timestamp = BUILD_TIMESTAMP,
    .url             = PROJECT_URL,
    .serial          = {.baud_rate = SERIAL_BAUD_RATE},
});

// Generated by ./setup.sh: includes and declares the selected modules, in dependency order.
#if __has_include("src/modules/Modules.h")
#include "src/modules/Modules.h"
#endif

// Project-local modules (contract-shaped: src/<Folder>/, module.properties, tests/test_<slug>.py).
#include "src/Fan/Fan.h"
#include "src/Mlx90614/Mlx90614.h"
#include "src/Argb/Argb.h"
#include "src/FanCurve/FanCurve.h"
#include "src/PadWeb/PadWeb.h"

Fan      fan(os, {.defaults = {{PAD_FAN1_PWM, PAD_FAN1_TACH}, {PAD_FAN2_PWM, PAD_FAN2_TACH}}});
Mlx90614 mlx90614(os, {.sda_pin = PAD_MLX_SDA, .scl_pin = PAD_MLX_SCL, .i2c_address = PAD_MLX_ADDR});
Argb     argb(os, {.default_pins = {PAD_ARGB1_PIN, PAD_ARGB2_PIN}, .default_length = PAD_ARGB_LEN});
FanCurve fan_curve(os, fan, mlx90614, argb);

PadWeb   pad_web(fan, mlx90614, argb, fan_curve);

void setup() {
    // routes on the web-interface module's server: the pad page at /pad, its JSON API beside it
    pad_web.attach(web_interface.get_server());
    os.begin();
}

void loop() {
    os.loop();
}
