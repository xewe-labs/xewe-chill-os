// xewe-os-laptop-cooling-pad/xewe-os-laptop-cooling-pad.ino
//
// XeWe laptop cooling pad on XeWe OS: XeWeCore's Os, the selected repo modules (wifi, web-interface,
// fan, mlx90614, led; generated Modules.h), then the pad's own code, PadWeb (src/PadWeb/).
// - Project name, version, timestamp: generated by `xewe build` (xewe.toml [project]); see Config.h.
// - Pin defaults: build defines of the modules (FAN*, MLX90614_*, LED_*); README "Pins per chip".
// - Modules: never edit src/Modules.h by hand; ./setup.sh generates it (modules live in build/modules/).

#include <XeWeCore.h>

#include "Config.h"

// The Os comes first: modules register themselves with it from their constructors.
XeWeOs os({
    .project_name    = PROJECT_NAME,
    .version         = BUILD_VERSION,
    .build_timestamp = BUILD_TIMESTAMP,
    .url             = PROJECT_URL,
    .serial          = {.baud_rate = SERIAL_BAUD_RATE},
});

// Generated by ./setup.sh: includes and declares the selected modules, in dependency order.
#if __has_include("src/Modules.h")
#include "src/Modules.h"
#endif

// The pad's glue, a project-local module (id `pad`): mlx90614 readings -> fan.set_temperature()
// (it registers itself as the sensor's listener), strip colour along the fan curve via led.fill(),
// and the /pad page.
#include "src/PadWeb/PadWeb.h"

PadWeb pad_web(os, fan, mlx90614, led);

void setup() {
    // routes on the web-interface module's server: the pad page at /pad and / (root hook; the command
    // console moves to /console), its JSON API beside it
    pad_web.attach(web_interface);
    os.begin();
}

void loop() {
    os.loop();
}
